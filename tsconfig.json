{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "common/**/*.ts",
    "week*/**/*.ts",
    "liquidity-vault/scripts/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/target",
    "liquidity-vault/app"
  ]
}
